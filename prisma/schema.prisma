generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CompanyBranding {
  id             String   @id @default(cuid())
  logoUrl        String?
  primaryColor   String   @default("#1e3a8a")
  secondaryColor String   @default("#3b82f6")
  accentColor    String   @default("#f59e0b")
  aiEnabled      Boolean  @default(false)
  azureOpenAiEndpoint String?
  azureOpenAiApiKey String?
  azureOpenAiDeploymentName String?
  updatedAt      DateTime @updatedAt
}

model UserAccess {
  id            String   @id @default(cuid())
  email         String   @unique
  role          Role     @default(ANALYST)
  isActive      Boolean  @default(true)
  authProviders String[] @default(["AZURE_AD"])
  createdAt     DateTime @default(now())
}

enum Role {
  ADMIN
  ADMIN_MANAGER
  ANALYST
  MANAGER
}

model AllowedDomain {
  id        String   @id @default(cuid())
  domain    String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Client {
  id              String   @id @default(cuid())
  name            String
  cuit            String   @unique
  taxRateIIBB     Float    @default(0)
  taxRateGanancias Float    @default(0)
  taxRateIVA      Float    @default(0)
  taxRateSUSS     Float    @default(0)
  projections     CashFlowProjection[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Vendor {
  id              String   @id @default(cuid())
  name            String
  projections     CashFlowProjection[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Category {
  id              String   @id @default(cuid())
  name            String
  type            CategoryType
  transactions    Transaction[]
  projections     CashFlowProjection[]
}

enum CategoryType {
  INCOME
  EXPENSE
}

model BankAccount {
  id              String   @id @default(cuid())
  name            String
  currency        Currency @default(ARS)
  initialBalance  Float    @default(0)
  transactions    Transaction[]
}

enum Currency {
  ARS
  USD
}

model Transaction {
  id              String   @id @default(cuid())
  date            DateTime
  description     String
  amount          Float
  bankAccountId   String
  bankAccount     BankAccount @relation(fields: [bankAccountId], references: [id])
  categoryId      String?
  category        Category?   @relation(fields: [categoryId], references: [id])
  isReconciled    Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model CashFlowProjection {
  id              String   @id @default(cuid())
  date            DateTime
  description     String
  amount          Float
  netAmount       Float
  currency        Currency @default(ARS)
  type            CategoryType
  clientId        String?
  client          Client?     @relation(fields: [clientId], references: [id])
  vendorId        String?
  vendor          Vendor?     @relation(fields: [vendorId], references: [id])
  categoryId      String?
  category        Category?   @relation(fields: [categoryId], references: [id])
  isReconciled    Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Investment {
  id              String   @id @default(cuid())
  name            String
  entity          String
  instrumentType  String
  termDays        Int?
  returnRate      Float?
  amount          Float
  currency        Currency @default(ARS)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
